{
  "name": "ssh-scp-deploy",
  "version": "2.0.0",
  "description": "SSH & SCP Deploy with GitHub Actions",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ncc build index.js -o dist --source-map --license licenses.txt && rm -rf dist/build dist/lib dist/pagent.exe",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "bash test/integration/test.sh",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilCollez/ssh-scp-deploy.git"
  },
  "author": "Collez",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ilCollez/ssh-scp-deploy/issues"
  },
  "homepage": "https://github.com/ilCollez/ssh-scp-deploy#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "glob": "^13.0.6",
    "node-ssh": "^13.2.0",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.4",
    "@vitest/coverage-v8": "^4.1.5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "undici": "^6.21.1"
  }
}
